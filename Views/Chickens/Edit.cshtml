@model ZambaFarm.Models.Chicken

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Chicken</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ChickenId" />
            <div class="form-group">
                <label asp-for="TagNumber" class="control-label"></label>
                <input asp-for="TagNumber" class="form-control" />
                <span asp-validation-for="TagNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="control-label"></label>
                <input asp-for="Gender" class="form-control" />
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BirthDate" class="control-label"></label>
                <input asp-for="BirthDate" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsMated" /> @Html.DisplayNameFor(model => model.IsMated)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfEggsLaid" class="control-label"></label>
                <input asp-for="NumberOfEggsLaid" class="form-control" />
                <span asp-validation-for="NumberOfEggsLaid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MatingDate" class="control-label"></label>
                <input asp-for="MatingDate" class="form-control" />
                <span asp-validation-for="MatingDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MotherChickenId" class="control-label"></label>
                <select asp-for="MotherChickenId" class="form-control" asp-items="ViewBag.MotherChickenId"></select>
                <span asp-validation-for="MotherChickenId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MotherTagNumber" class="control-label"></label>
                <input asp-for="MotherTagNumber" class="form-control" />
                <span asp-validation-for="MotherTagNumber" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsEggLaying" /> @Html.DisplayNameFor(model => model.IsEggLaying)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfEggs" class="control-label"></label>
                <input asp-for="NumberOfEggs" class="form-control" />
                <span asp-validation-for="NumberOfEggs" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateAdded" class="control-label"></label>
                <input asp-for="DateAdded" class="form-control" />
                <span asp-validation-for="DateAdded" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


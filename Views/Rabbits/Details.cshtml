@model ZambaFarm.Models.Rabbit

@{
    ViewData["Title"] = "Rabbit Details";

    // Calculate Age
    int years = DateTime.Now.Year - Model.BirthDate.Year;
    int months = DateTime.Now.Month - Model.BirthDate.Month;

    if (months < 0)
    {
        years--;
        months += 12;
    }

    string ageText = years > 0 ? $"{years} years {months} months" : $"{months} months";
}

<div class="details-container mt-5 text-white">
    <div class="animated-border"></div>
    <div class="details-card">
        <div class="card-body">
            <h2 class="text-primary">Rabbit Details</h2>
            <hr>

            <!-- 🖼️ Display Rabbit Image Above Table -->
            <div class="text-center mb-3">
                @if (Model.Image != null && Model.Image.Length > 0)
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Image)"
                         alt="Rabbit Image" class="img-fluid rounded shadow" width="250" 
                         style="max-width: 100%; height: auto; object-fit: cover; border-radius: 10px;" />
                }
                else
                {
                    <p class="text-muted">No image available.</p>
                }
            </div>
            <table class="table table-bordered">
                <tbody>
                    <!-- Display Tag Number -->
                    <tr class="text-white fw-bold">
                        <th>Tag Number</th>
                        <td>@Model.TagNumber</td>
                    </tr>

                    <!-- Display Cage Number -->
                    <tr class="text-white fw-bold">
                        <th>Cage Number</th>
                        <td>@Model.Cage</td>
                    </tr>

                    <!-- Display Gender -->
                    <tr class="text-white fw-bolder">
                        <th>Gender</th>
                        <td>@Model.Gender</td>
                    </tr>

                    <!-- Display Age -->
                    <tr class="text-white">
                        <th>Age</th>
                        <td>@ageText</td>
                    </tr>

                    <!-- Female-specific Details -->
                    @if (Model.Gender == "Female")
                    {
                            <tr class="text-white">
                                <th>Is Pregnant</th>
                                <td>@(Model.IsPregnant ? "Yes" : "No")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Is Nursing</th>
                                <td>@(Model.IsNursing ? "Yes" : "No")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Mating Date</th>
                                <td>@(Model.MatingDate?.ToShortDateString() ?? "N/A")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Predicted Delivery Date</th>
                                <td>@(Model.DeliveryDate?.ToShortDateString() ?? "N/A")</td>
                            </tr>
                    }

                    <!-- Display Status -->
                    <tr class="text-white">
                        <th>Status</th>
                        <td>@Model.Status</td>
                    </tr>

                    <!-- Mother Information -->
                    <tr class="text-white">
                        <th>Mother</th>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.MotherTagNumber))
                            {
                                var mother = ViewData["MotherDetails"] as ZambaFarm.Models.Rabbit;
                                if (mother != null)
                                {
                                            <a asp-action="Details" asp-route-id="@mother.RabbitId">
                                        @Model.MotherTagNumber
                                            </a>
                                }
                                else
                                {
                                            <span>Mother not found.</span>
                                }
                            }
                            else
                            {
                                    <span>N/A</span>
                            }
                        </td>
                    </tr>

                    <!-- Offspring Information -->
                    <tr class="text-white">
                        <th>Offspring</th>
                        <td>
                            @if (Model.Offspring.Any())
                            {
                                    <ul>
                                    @foreach (var baby in Model.Offspring)
                                    {
                                        // Calculate age for offspring
                                        int babyYears = DateTime.Now.Year - baby.BirthDate.Year;
                                        int babyMonths = DateTime.Now.Month - baby.BirthDate.Month;
                                        if (babyMonths < 0)
                                        {
                                            babyYears--;
                                            babyMonths += 12;
                                        }

                                        string babyAge = babyYears > 0 ? $"{babyYears} years {babyMonths} months" : $"{babyMonths} months";

                                                <li>
                                                    <a asp-action="Details" asp-route-id="@baby.RabbitId">
                                                        Tag: @baby.TagNumber, Age: @babyAge
                                                    </a>
                                                </li>
                                    }
                                    </ul>
                            }
                            else
                            {
                                    <span>No offspring yet.</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Action Buttons -->
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.RabbitId" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
 
@model ZambaFarm.Models.Rabbit

@{
    ViewData["Title"] = "Rabbit Details";
}

<div class="details-container mt-5 text-white">
    <div class="animated-border"></div>
    <div class="details-card " >
        <div class="card-body">
            <h2 class="text-primary">Rabbit Details</h2>
            <hr>
            <table class="table table-bordered" >
                <tbody>
                    <tr class=" text-warning fw-bold" >
                        
                        <th> Tag Number</th>
                        <td>@Model.TagNumber</td>
                    </tr>
                    <tr class="text-danger fw-bolder">
                        <th >Gender</th>
                        <td>@Model.Gender</td>
                    </tr>
                    <tr class=" text-white">
                        <th >Birth Date</th>
                        <td>@Model.BirthDate.ToShortDateString()</td>
                    </tr>
                    @if (Model.Gender == "Female")
                    {
                        <tr class=" text-white">
                            <th >Is Pregnant</th>
                            <td>@(Model.IsPregnant ? "Yes" : "No")</td>
                        </tr>
                        <tr class=" text-white">
                            <th >Is Nursing</th>
                            <td>@(Model.IsNursing ? "Yes" : "No")</td>
                        </tr>
                        <tr class="text-white fw-bold">
                            <th >Mating Date</th>
                            <td>@(Model.MatingDate?.ToShortDateString() ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th >Predicted Delivery Date</th>
                            <td>@(Model.DeliveryDate?.ToShortDateString() ?? "N/A")</td>
                        </tr>
                    }
                    <tr class=" text-white ">
                        <th >Status</th>
                        <td>@Model.Status</td>
                    </tr>
                </tbody>
            </table>
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.RabbitId" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>



@model ZambaFarm.Models.Rabbit

@{
    ViewData["Title"] = "Rabbit Details";
}

<div class="container mt-5">
    <!-- Page Header -->
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="text-primary">Rabbit Details</h2>
            <p class="text-muted">Detailed information about the selected rabbit</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle me-2"></i>Back to Dashboard</a>
        </div>
    </div>

    <!-- Rabbit Information -->
    <div class="row justify-content-center">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Tag Number</dt>
                <dd class="col-sm-8">@Model.TagNumber</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Birth Date</dt>
                <dd class="col-sm-8">@Model.BirthDate.ToShortDateString()</dd>

                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">@Model.Age months</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>

                <dt class="col-sm-4">Pregnancy</dt>
                <dd class="col-sm-8">@Model.IsPregnant ? "Yes" : "No"</dd>

                <dt class="col-sm-4">Nursing</dt>
                <dd class="col-sm-8">@Model.IsNursing ? "Yes" : "No"</dd>

                <dt class="col-sm-4">Mating</dt>
                <dd class="col-sm-8">@Model.IsMating ? "Yes" : "No"</dd>
            </dl>
        </div>
    </div>
</div>

@{
    ViewBag.Title = "Dashboard";
}

<h2>Dashboard</h2>




<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<canvas id="totalAnimalsChart"></canvas>
<canvas id="monthlyGrowthChart"></canvas>

<script>
    async function loadCharts() {
        // Fetch animal counts
        const animalCountsRes = await fetch('/api/dashboard/animalCounts');
        const animalCounts = await animalCountsRes.json();

        const totalAnimalChart = new Chart(document.getElementById('totalAnimalsChart'), {
            type: 'bar',
            data: {
                labels: ['Goats', 'Pigs', 'Turkeys', 'Rabbits'],
                datasets: [{
                    label: 'Total Count',
                    data: [animalCounts.Goats, animalCounts.Pigs, animalCounts.Turkeys, animalCounts.Rabbits],
                    backgroundColor: ['blue', 'red', 'green', 'purple']
                }]
            }
        });

        // Fetch monthly animal count data
        const monthlyCountsRes = await fetch('/api/dashboard/monthlyAnimalCounts');
        const monthlyCounts = await monthlyCountsRes.json();

        const labels = [...new Set(monthlyCounts.map(d => `${d.Year}-${d.Month}`))];
        const species = ['Goats', 'Pigs', 'Turkeys', 'Rabbits'];

        const datasets = species.map(sp => ({
            label: sp,
            data: labels.map(lab => {
                const entry = monthlyCounts.find(d => `${d.Year}-${d.Month}` === lab && d.Species === sp);
                return entry ? entry.Count : 0;
            }),
            backgroundColor: getColor(sp)
        }));

        const monthlyChart = new Chart(document.getElementById('monthlyGrowthChart'), {
            type: 'bar',
            data: { labels, datasets }
        });

        function getColor(species) {
            return { 'Goats': 'blue', 'Pigs': 'red', 'Turkeys': 'green', 'Rabbits': 'purple' }[species];
        }
    }

    loadCharts();
</script>









<div id="speciesChart" style="width: 100%; height: 400px;"></div>

<h2>Overall Statistics Dashboad </h2>

<script src="https://www.gstatic.com/charts/loader.js"></script>
<script>
    google.charts.load('current', { packages: ['corechart', 'bar'] });
    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {
        var data = google.visualization.arrayToDataTable([
            ['Species', 'Count'],
            ['Rabbits', @ViewBag.TotalRabbits],
            ['Pigs', @ViewBag.TotalPigs],
            ['Cattles', @ViewBag.TotalCattles],
            ['Goats', @ViewBag.TotalGoats],
            ['Turkeys', @ViewBag.TotalTurkeys],
            ['Chickens', @ViewBag.TotalChickens],
            ['Ducks', @ViewBag.TotalDucks]
        ]);

        var options = {
            title: 'Animal Species Counts',
            chartArea: {
                width: '50%',
                backgroundColor: { fill: '#f9f9f9' }
            },
            hAxis: {
                title: 'Count',
                    titleTextStyle: { color: '#2e2e2e', fontSize: 16, fontName: 'Verdana', bold: true },
                minValue: 0,
                textStyle: { color: '#444', fontSize: 12, fontName: 'Verdana' }
            },
            vAxis: {
                title: 'Species',
                titleTextStyle: { color: '#2e2e2e', fontSize: 16, fontName: 'Verdana', bold: true },
                textStyle: { color: '#444', fontSize: 12, fontName: 'Verdana' }
            }                            
        };

        var chart = new google.visualization.BarChart(document.getElementById('speciesChart'));
        chart.draw(data, options);
    }
</script>  



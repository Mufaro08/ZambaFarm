@model ZambaFarm.Models.Turkey

@{
    ViewData["Title"] = "Turkey Details";
}

<div class="container mt-5">
    <h2 class="text-primary">Turkey Details</h2>
    <p class="text-muted">View detailed information about the turkey.</p>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Tag Number</label>
                <input type="text" class="form-control" value="@Model.TagNumber" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Gender</label>
                <input type="text" class="form-control" value="@Model.Gender" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Birth Date</label>
                <!-- Ensure BirthDate is handled as a DateTime (if it's not nullable) -->
                <input type="text" class="form-control" value="@Model.BirthDate.ToString("yyyy-MM-dd")" readonly />
            </div>
        </div>
    </div>

    <div class="mb-3 text-md-end">
        <a asp-action="Edit" asp-route-id="@Model.TurkeyId" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div>

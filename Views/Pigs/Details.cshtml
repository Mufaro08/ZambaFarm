@model ZambaFarm.Models.Pig

@{
    ViewData["Title"] = "Pig Details";

    // Calculate Age
    int years = DateTime.Now.Year - Model.BirthDate.Year;
    int months = DateTime.Now.Month - Model.BirthDate.Month;

    if (months < 0)
    {
        years--;
        months += 12;
    }

    string ageText = years > 0 ? $"{years} years {months} months" : $"{months} months";
}

<div class="details-container mt-5 text-white">
    <div class="animated-border">       
    </div>
    <div class="details-card">
         <div class="card-body">
             <h2 class="text-primary">Pig Details</h2>
            <p class="text-muted">View detailed information about the pig.</p>

            <hr />
             <table class="table table-bordered">
                <tbody>
                    <!-- Display Tag Number -->
                    <tr class="text-white fw-bold">
                        <th>Tag Number</th>
                        <td>@Model.TagNumber</td>
                    </tr>

                    <!-- Display Gender -->
                    <tr class="text-white fw-bolder">
                        <th>Gender</th>
                        <td>@Model.Gender</td>
                    </tr>

                    <!-- Display Age -->
                    <tr class="text-white">
                        <th>Age</th>
                        <td>@ageText</td>
                    </tr>

                    <!-- Female-specific Details -->
                    @if (Model.Gender == "Female")
                    {
                            <tr class="text-white">
                                <th>Is Pregnant</th>
                                <td>@(Model.IsPregnant ? "Yes" : "No")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Is Nursing</th>
                                <td>@(Model.IsNursing ? "Yes" : "No")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Mating Date</th>
                                <td>@(Model.MatingDate?.ToShortDateString() ?? "N/A")</td>
                            </tr>
                            <tr class="text-white">
                                <th>Predicted Delivery Date</th>
                                <td>@(Model.DeliveryDate?.ToShortDateString() ?? "N/A")</td>
                            </tr>
                    }

                    <!-- Display Status -->
                    <tr class="text-white">
                        <th>Status</th>
                        <td>@Model.Status</td>
                    </tr>

                    <!-- Mother Information -->
                    <tr class="text-white">
                        <th>Mother</th>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.MotherTagNumber))
                            {
                                var mother = ViewData["MotherDetails"] as ZambaFarm.Models.Pig;
                                if (mother != null)
                                {
                                            <a asp-action="Details" asp-route-id="@mother.PigId">
                                        @Model.MotherTagNumber
                                            </a>
                                }
                                else
                                {
                                            <span>Mother not found.</span>
                                }
                            }
                            else
                            {
                                    <span>N/A</span>
                            }
                        </td>
                    </tr>

                    <!-- Offspring Information -->
                    <tr class="text-white">
                        <th>Offspring</th>
                        <td>
                            @if (Model.Offspring.Any())
                            {
                                    <ul>
                                    @foreach (var baby in Model.Offspring)
                                    {
                                                <li>
                                                    <a asp-action="Details" asp-route-id="@baby.PigId">
                                                        Tag: @baby.TagNumber, Birth Date: @baby.BirthDate.ToShortDateString()
                                                    </a>
                                                </li>
                                    }
                                    </ul>
                            }
                            else
                            {
                                    <span>No offspring yet.</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
    
    <div class="mb-3 text-md-end">
        <a asp-action="Edit" asp-route-id="@Model.PigId" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div>
        </div>
    </div>
    
